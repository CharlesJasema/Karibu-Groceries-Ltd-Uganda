# SERVER CONFIG
PORT=3000
NODE_ENV=development

# DATABASE
DATABASE_URI=mongodb://localhost:27017/karibu_groceries_db

# JWT CONFIG - GENERATE NEW SECRETS!
JWT_SECRET=your_jwt_secret_here_generate_new_one
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_secret_here_generate_new_one
JWT_REFRESH_EXPIRES_IN=7d

# EMAIL CONFIG
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# SMS CONFIG (Africa's Talking - Uganda)
SMS_API_KEY=your_sms_api_key_here
SMS_USERNAME=sandbox
SMS_SENDER_ID=your_sender_id

# FRONTEND (CORS)
CLIENT_URL=http://localhost:3000

# USER SEEDING
DEFAULT_USER_PASSWORD=your_secure_password_here